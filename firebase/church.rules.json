{
  "church": {
    "platform": {
      "adminUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'anyplan@me.com' && newData.val() == auth.uid && (!data.exists() || data.val() == auth.uid)"
      }
    },
    "churchIndex": {
      ".read": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val())",
      ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val())"
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || root.child('church/accounts').child(auth.uid).child('churchId').val() == data.child('churchId').val())",
        ".write": "auth != null && ((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || (root.child('church/accounts').child(auth.uid).child('roles/admin').val() == true && newData.child('churchId').val() == root.child('church/accounts').child(auth.uid).child('churchId').val()))"
      }
    },
    "churches": {
      ".read": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val())",
      "$churchId": {
        ".read": "auth != null && ((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId)",
        "meta": {
          ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val())"
        },
        "data": {
          ".write": "auth != null && ((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || (root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId && (root.child('church/accounts').child(auth.uid).child('roles/prepare').val() == true || root.child('church/accounts').child(auth.uid).child('roles/run').val() == true || root.child('church/accounts').child(auth.uid).child('roles/output').val() == true || root.child('church/accounts').child(auth.uid).child('roles/directory').val() == true || root.child('church/accounts').child(auth.uid).child('roles/admin').val() == true)))"
        },
        "files": {
          ".write": "auth != null && ((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || (root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId && root.child('church/accounts').child(auth.uid).child('roles/admin').val() == true))"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) || (root.child('church/accounts').child(auth.uid).child('roles/admin').val() == true && root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId && newData.child('churchId').val() == $churchId))"
          }
        }
      }
    },
    "community": {
      ".read": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists())",
      "regions": {
        "$regionId": {
          ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $regionId.matches(/^[0-9A-Za-z가-힣\\-]{1,48}$/)"
        }
      },
      "memberships": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && newData.child('regionId').isString() && newData.child('sido').isString() && newData.child('churchId').isString() && (((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) && newData.child('churchId').val().matches(/^c[a-z0-9]{6,16}$/)) || (root.child('church/accounts').child(auth.uid).exists() && newData.child('churchId').val() == root.child('church/accounts').child(auth.uid).child('churchId').val()))"
        }
      },
      "posts": {
        "$regionId": {
          "$postId": {
            ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $regionId.matches(/^[0-9A-Za-z가-힣\\-]{1,48}$/) && $postId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)",
            "comments": {
              "$commentId": {
                ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $commentId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
              }
            }
          }
        }
      },
      "resources": {
        "$regionId": {
          "$resourceId": {
            ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $regionId.matches(/^[0-9A-Za-z가-힣\\-]{1,48}$/) && $resourceId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
          }
        }
      },
      "profiles": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && newData.child('churchId').isString() && (((auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val()) && newData.child('churchId').val().matches(/^c[a-z0-9]{6,16}$/)) || (root.child('church/accounts').child(auth.uid).exists() && newData.child('churchId').val() == root.child('church/accounts').child(auth.uid).child('churchId').val()))"
        }
      },
      "groups": {
        "$regionId": {
          "$groupId": {
            ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $regionId.matches(/^[0-9A-Za-z가-힣\\-]{1,48}$/) && $groupId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)",
            "members": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists())"
              }
            },
            "posts": {
              "$postId": {
                ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $postId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
              }
            },
            "schedule": {
              "$scheduleId": {
                ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $scheduleId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
              }
            },
            "album": {
              "$itemId": {
                ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $itemId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
              }
            }
          }
        }
      },
      "bookmarks": {
        "$uid": {
          "$key": {
            ".write": "auth != null && auth.uid == $uid && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $key.matches(/^[0-9A-Za-z가-힣_\\-]{3,120}$/)"
          }
        }
      },
      "churches": {
        "$churchId": {
          "notices": {
            "$noticeId": {
              ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || (root.child('church/accounts').child(auth.uid).exists() && root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId)) && $churchId.matches(/^c[a-z0-9]{6,16}$/) && $noticeId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
            }
          },
          "schedule": {
            "$scheduleId": {
              ".write": "auth != null && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || (root.child('church/accounts').child(auth.uid).exists() && root.child('church/accounts').child(auth.uid).child('churchId').val() == $churchId)) && $churchId.matches(/^c[a-z0-9]{6,16}$/) && $scheduleId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
            }
          }
        }
      },
      "chats": {
        "$uid": {
          "$threadId": {
            ".write": "auth != null && auth.uid == $uid && (auth.token.email == 'anyplan@me.com' || auth.uid == root.child('church/platform/adminUid').val() || root.child('church/accounts').child(auth.uid).exists()) && $threadId.matches(/^[A-Za-z0-9_\\-]{6,64}$/)"
          }
        }
      }
    }
  }
}
