# 이 파일을 복사해 .env 로 저장한 뒤 값만 채우세요.
# .env 는 깃에 올리지 않습니다. 비밀번호를 코드에 적지 마세요.
#
# 데이터베이스가 없어도 타입체크와 단위 테스트는 실행됩니다.
# 이 컴퓨터에서만 개발할 때 아래 이름에 접속 문자열을 넣습니다.
# 공개 앱은 이 파일의 주소를 쓰지 않습니다.
# 공개 앱은 modl-comm 프로젝트의 Postgres를 쓰고, 비밀번호는 비밀 저장소에만 있습니다.
# 공개 앱이 읽는 이름은 CLOUD_SQL_CONNECTION_NAME, DB_USER, DB_NAME, DB_PASSWORD 입니다.
# 그 값과 접속 문자열은 이 예시에 적지 않습니다.
# 버셀(공개 웹을 올려 두는 또 다른 곳)에는 구글 기본 로그인이 없습니다.
# 데이터베이스 인증서를 받을 때만 GOOGLE_SQL_ADMIN_CREDENTIALS 이름을 씁니다. 값은 적지 않습니다.
GOOGLE_SQL_ADMIN_CREDENTIALS=

DATABASE_URL=

# 카카오톡 공유. 값을 비우면 공유 버튼은 제목, 날짜, 공개 주소를 복사합니다.
# 자바스크립트 키가 있을 때만 카카오 공유 카드를 띄웁니다.
KAKAO_JAVASCRIPT_KEY=
KAKAO_SHARE_TEMPLATE_ID=

# 카카오 로그인. 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# 리다이렉트 주소는 https://modl-jeju.vercel.app/api/auth/callback/kakao 만 씁니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 로그인. 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# 콜백 주소는 https://modl-jeju.vercel.app/api/auth/callback/naver 만 씁니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 달력. 열쇠와 달력 번호 값은 이 파일에 적지 않습니다.
# 달력 번호는 앱 호스팅 비밀 GOOGLE_CALENDAR_ID 에만 있습니다.
# 번호가 없으면 구글에 보내지 않고, 없는 일정을 만들지 않습니다.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# 말씀 사진에서 본문과 질문을 읽을 때 쓰는 열쇠입니다.
# 비어 있으면 사람이 직접 적고, 읽었다고 말하지 않습니다.
QT_OCR_API_KEY=

# 주보의 1부·2부와 담당을 규칙으로 나누지 못할 때만 서버가 부르는 제미나이 열쇠입니다.
# 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# 버셀 환경 변수 이름은 GEMINI_API_KEY 입니다. 없으면 규칙만 사용합니다.
# GEMINI_MODEL 을 비우면 gemini-2.5-flash 를 씁니다.
GEMINI_API_KEY=
GEMINI_MODEL=

# 안내 메일. 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# 받는 주소는 modl.jeju@gmail.com 입니다.
# GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN 이 있으면 그 갱신 열쇠로 읽습니다.
# 없으면 이미 있는 구글 서비스 계정으로 그 메일함 읽기를 시도합니다.
# CRON_SECRET 은 버셀 일정 호출만 통과시킵니다.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
CRON_SECRET=

# 재정 화면이 시트1을 읽을 때 쓰는 이름입니다. 값은 앱 호스팅 비밀 저장소에만 둡니다.
GOOGLE_SHEETS_SERVICE_ACCOUNT=
GOOGLE_SHEETS_SPREADSHEET_ID=
# 시트 계정 열쇠의 이름입니다. 값은 호스팅 비밀 저장소에만 있습니다.
# 비공개 구글 달력은 이 계정으로 읽습니다. 이 파일에는 값을 적지 않습니다.
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# 방문 문의 푸시. 값이 없으면 사역자와 임원 화면의 알림 목록만 갱신합니다.
# 보내지 못한 푸시를 보낸 것처럼 말하지 않습니다.
INQUIRY_PUSH_KEY=

# 인스타그램 최신 글. 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# META_GRAPH_ACCESS_TOKEN 은 비즈니스 계정의 긴 사용 표입니다.
# META_INSTAGRAM_USER_ID 는 그 표의 인스타그램 사용자 번호입니다.
# 둘 중 하나가 없으면 그 교회나 모들 페이지에 빈 격자를 만들지 않습니다.
META_GRAPH_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=

# 유튜브 최신 글. 값은 비워 둡니다. 코드와 깃에 적지 않습니다.
# 채널 주소는 공개 목록으로 먼저 읽습니다. 그 읽기가 안 될 때만 이 열쇠를 씁니다.
YOUTUBE_API_KEY=

# 지도 그림. 값은 앱 호스팅 비밀 MAPBOX_ACCESS_TOKEN 에만 있습니다.
# 이 파일에는 이름을 두고 값은 비워 둡니다.
MAPBOX_ACCESS_TOKEN=

# 폰, 패드, 맥 앱을 테스트플라이트에 올릴 때 쓰는 이름입니다.
# 값은 비워 둡니다. 코드와 이 예시 파일에 적지 않습니다.
# 하나라도 없거나 Xcode 가 없으면 올리지 않습니다.
APPLE_ID=
APPLE_TEAM_ID=
MODL_BUNDLE_ID=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=
