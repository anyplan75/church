# 이 파일을 복사해 .env 로 저장한 뒤 값만 채우세요.
# .env 는 깃에 올리지 않습니다. 비밀번호를 코드에 적지 마세요.
#
# 데이터베이스가 없어도 타입체크와 단위 테스트는 실행됩니다.
# 표를 실제로 만들 때만 아래 주소가 필요합니다.

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/modl

# 카카오톡 공유. 값을 비우면 공유 버튼은 제목, 날짜, 공개 주소를 복사합니다.
# 자바스크립트 키가 있을 때만 카카오 공유 카드를 띄웁니다.
KAKAO_JAVASCRIPT_KEY=
KAKAO_SHARE_TEMPLATE_ID=

# 구글 달력 동기화. 네 값이 모두 있을 때만 일정을 구글에 보냅니다.
# 하나라도 비어 있으면 모들 달력만 쓰고, 동기화했다고 말하지 않습니다.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# 말씀 사진에서 본문과 질문을 읽을 때 쓰는 열쇠입니다.
# 비어 있으면 사람이 직접 적고, 읽었다고 말하지 않습니다.
QT_OCR_API_KEY=

# 구글 스프레드시트 동기화. 네 값이 모두 있을 때만 살림 내역을 보냅니다.
# 하나라도 비어 있으면 버튼은 열쇠가 필요하다고 안내하고, 엑셀 받기는 그대로 됩니다.
# 보내지 못한 일을 보낸 것처럼 말하지 않습니다.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=

# 방문 문의 푸시. 값이 없으면 사역자와 임원 화면의 알림 목록만 갱신합니다.
# 보내지 못한 푸시를 보낸 것처럼 말하지 않습니다.
INQUIRY_PUSH_KEY=
